#!/usr/bin/env bash

# The quick checks, before each commit: formatting and function complexity.
# Enable it once per clone with
#
#   git config core.hooksPath .githooks
#
# It checks the working tree rather than the staged content, so stage what you
# check. scripts/check.sh runs everything CI runs; `git commit --no-verify`
# skips this hook.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
scripts/format.sh --check || {
  echo "pre-commit: run scripts/format.sh --fix, then stage the result" >&2
  exit 1
}
scripts/complexity.sh
